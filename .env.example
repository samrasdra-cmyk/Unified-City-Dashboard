# ===== General =====
ENV=production
LOG_LEVEL=INFO

# ===== API Adapter toggle =====
# Set to False (or leave TOMTOM_API_KEY empty) to force the simulator fallback
API_ADAPTER_ENABLED=True

# ===== Real API Keys =====
TOMTOM_API_KEY=
OPENWEATHER_API_KEY=
GTFS_RT_URL=

# ===== City / Grid config =====
CITY_NAME=Sample City
CITY_CENTER_LAT=52.5200
CITY_CENTER_LNG=13.4050
GRID_RADIUS_DEG=0.03
GRID_STEP_DEG=0.01

# ===== Polling intervals (seconds) =====
TRAFFIC_POLL_INTERVAL=60
AIR_POLL_INTERVAL=900
TRANSIT_POLL_INTERVAL=15
WASTE_POLL_INTERVAL=300

# ===== Circuit breaker =====
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RESET_SECONDS=300

# ===== Kafka =====
 # ===== Kafka =====
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SECURITY_PROTOCOL=
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_USERNAME=
KAFKA_PASSWORD=
# Optional. Put Aiven's CA certificate at backend/ca.pem for Docker deployments.
KAFKA_SSL_CA_LOCATION=./ca.pem
KAFKA_TOPIC_TRAFFIC=traffic.speed
KAFKA_TOPIC_AIR=air.quality
KAFKA_TOPIC_TRANSIT=transit.gps
KAFKA_TOPIC_WASTE=waste.level
KAFKA_CONSUMER_GROUP=city-dashboard-consumer

# ===== Postgres / PostGIS / TimescaleDB =====
POSTGRES_HOST=postgis
POSTGRES_PORT=5432
POSTGRES_DB=citydashboard
POSTGRES_USER=citydashboard
POSTGRES_PASSWORD=citydashboard_pw
DATABASE_URL=postgresql+asyncpg://citydashboard:citydashboard_pw@postgis:5432/citydashboard

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=
REDIS_SNAPSHOT_TTL_SECONDS=10

# ===== Frontend =====
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/live
VITE_MAPBOX_TOKEN=
